rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write only their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Quotas: users can read their own; writes are server-only (except initial create)
    match /quotas/{userId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      // Allow client to create their own quota document (first-time setup)
      allow create: if request.auth != null && request.auth.uid == userId;
      // All other writes must come from a trusted server (Admin SDK)
      allow update, delete: if false;
    }

    // Sessions belong to the user who created them
    match /sessions/{sessionId} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }

    // Shared content is readable by any authenticated user; only admins write
    match /shared/{document=**} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
  }
}
