rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write only their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Quotas: users can read/update own doc; admin can read all
    match /quotas/{userId} {
      allow read:   if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'thisisbaebae@gmail.com');
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Sessions belong to the user who created them
    match /sessions/{sessionId} {
      allow read:   if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }

    // Shared content is readable by any authenticated user; only admins write
    match /shared/{document=**} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // Platform stats — admin read, any auth user can increment (write)
    match /_platform/stats {
      allow read:  if request.auth != null && request.auth.token.email == 'thisisbaebae@gmail.com';
      allow write: if request.auth != null;
    }
  }
}
